    "start": "node middleware/server.js"
  },
  "dependencies": {
    "@cloudinary/url-gen": "^1.22.0",
    "@cloudinary/vue": "^1.13.4",
    "@quasar/extras": "^2.0.4",
    "@types/marked": "^5.0.2",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "marked": "^18.0.5",
    "quasar": "^2.23.5",
    "sass-loader": "^17.0.0",
    "vue": "^3.5.38",
    "vue-router": "^5.2.0",
    "vue-socials": "^2.0.3"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-mangle": "^1.0.1",
    "postcss": "^8.5.26",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.3",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "form-data": "^4.0.6",
    "js-yaml": "^5.1.0",
