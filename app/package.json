{
  "name": "marcelo-munhoz-website",
  "version": "2.2.1",
  "productName": "Marcelo Munhoz Website",
  "author": "Marcelo Munhoz",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "node --test",
    "scan:build-credentials": "node scripts/scan-built-assets.js dist",
